# Safe, non-secret GCP deployment identifiers for CloudSegmentation.
# This file is intentionally safe to commit. Never add credentials, API keys,
# billing-account IDs, service-account key JSON, access tokens, or secrets here.

GCP_PROJECT_ID=cloudsegmentation-506305
GCP_REGION=asia-northeast1

# Private model/sample storage.
GCP_ARTIFACT_BUCKET=cloudsegmentation-506305-artifacts
GCP_RUNTIME_SERVICE_ACCOUNT=cloudseg-runtime@cloudsegmentation-506305.iam.gserviceaccount.com

# Desired names for resources that may not exist yet. Verify idempotently before creating.
GCP_ARTIFACT_REPOSITORY=cloudsegmentation
GCP_CLOUD_RUN_SERVICE=cloudsegmentation
GCP_IMAGE_NAME=cloudsegmentation

# Cloud Run safety defaults. Do not relax these without explicit user approval.
GCP_CLOUD_RUN_CPU=1
GCP_CLOUD_RUN_MEMORY=2Gi
GCP_CLOUD_RUN_MIN_INSTANCES=0
GCP_CLOUD_RUN_MAX_INSTANCES=1
GCP_CLOUD_RUN_CONCURRENCY=1
GCP_CLOUD_RUN_ALLOW_UNAUTHENTICATED=false

# Private GCS object layout.
CLOUDSEG_GCS_MODEL_OBJECT=models/garg_benchmark_seed42/model.fp32.onnx
CLOUDSEG_GCS_SAMPLE_PREFIX=samples/

# Deployment-model integrity values from manifests/optimized_models.toml.
CLOUDSEG_MODEL_BYTES=134949341
CLOUDSEG_MODEL_SHA256=36628caa6289da9fa76d93369525b1d5a0a35d4cd2ecfbcabcf775d6dfb85b88
