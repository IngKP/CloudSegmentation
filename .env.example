# The sibling research checkout is read-only to this project.
SAR_RESEARCH_ROOT=../SARfloodEstimation

# Large local artifacts stay outside Git.
CLOUDSEG_ARTIFACT_ROOT=.artifacts

# Phase 3 serving paths and fixed ONNX Runtime thread count.
CLOUDSEG_MODEL_PATH=.artifacts/onnx/garg_benchmark_seed42/model.fp32.onnx
CLOUDSEG_SAMPLE_ROOT=.artifacts/samples
CLOUDSEG_ORT_THREADS=1
